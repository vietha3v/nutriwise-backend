# Database
DATABASE_URL=postgresql://username:password@localhost:5432/nutriwise_db
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=your_username
DB_PASSWORD=your_password
DB_NAME=nutriwise_db

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRATION_TIME=1h
REFRESH_TOKEN_EXPIRATION_TIME=30d

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Google OAuth Configuration
ENABLE_GOOGLE_OAUTH=true
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/callback/google

# Facebook OAuth Configuration (Optional)
ENABLE_FACEBOOK_OAUTH=false
FACEBOOK_CLIENT_ID=your-facebook-client-id
FACEBOOK_CLIENT_SECRET=your-facebook-client-secret
FACEBOOK_CALLBACK_URL=http://localhost:3000/api/auth/callback/facebook

# Zalo OAuth Configuration (Optional)
ENABLE_ZALO_OAUTH=false
ZALO_CLIENT_ID=your-zalo-client-id
ZALO_CLIENT_SECRET=your-zalo-client-secret

# Cookie Configuration
COOKIE_MAX_AGE=2592000000

# Environment
NODE_ENV=development
FRONTEND_URL=http://localhost:3000